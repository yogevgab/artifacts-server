{
  // Cloudflare Workers config. Run `npm run setup` to fill in the placeholders
  // automatically, or edit them by hand (see README → Deployment).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "observability": { "enabled": true },

  // rtfx.pro = app/dashboard/API; a.rtfx.pro = artifact content only (must be a
  // zone on your account). See CONTENT_HOSTNAMES below for the isolation this pairs with.
  "routes": [
    { "pattern": "rtfx.pro", "custom_domain": true },
    { "pattern": "a.rtfx.pro", "custom_domain": true }
  ],

  "r2_buckets": [{ "binding": "FILES", "bucket_name": "artifacts-files" }],

  // One chat room per artifact. Keyed by slug, so the coordination atom is a
  // single document's conversation rather than a global bottleneck.
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],

  // `npm run setup` (or `wrangler d1 create`) fills in database_id.
  "d1_databases": [
    { "binding": "DB", "database_name": "artifacts-meta", "database_id": "05f77557-3709-43b9-aad8-0cddf53765a8" }
  ],

  // Cloudflare Email Sending. Restricted to one sender on purpose: this Worker
  // also serves user-uploaded HTML from a.rtfx.pro, so capping the addresses it
  // can send From limits the blast radius of any future bug. Requires
  // `wrangler email sending enable rtfx.pro` to have been run on the account.
  // Never add "remote": true here — that sends real mail from local dev.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@rtfx.pro"] }
  ],

  "vars": {
    // Comma-separated emails with admin (publish/delete/manage) rights.
    "ADMIN_EMAILS": "yogevgab@gmail.com",
    // Envelope sender for transactional email. Must appear in the EMAIL
    // binding's allowed_sender_addresses above.
    "MAIL_FROM": "no-reply@rtfx.pro",
    // Cloudflare Access is intentionally disabled for rtfx.pro production.
    // Public sign-in is app-owned email OTP/session; leaving stale Access AUDs
    // here would create a parallel identity path that bypasses signup/account
    // attachment. Use app API tokens for non-interactive publishing instead.
    "ADMIN_SERVICE_TOKENS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Comma-separated hostnames that serve artifact content ONLY (no admin/API/
    // dashboard). Each hostname listed here must also have a `routes` entry above.
    // Leave empty to keep a single origin.
    "CONTENT_HOSTNAMES": "a.rtfx.pro",
    // --- Lemon Squeezy billing. The signing secret is NOT here: it is set with
    //     `wrangler secret put LEMONSQUEEZY_WEBHOOK_SECRET`. ---
    // The store's SUBDOMAIN, not the numeric store id (#452239) — hosted
    // checkout URLs address a store as <subdomain>.lemonsqueezy.com.
    "LEMONSQUEEZY_STORE_ID": "rtfxpro",
    // Variants of product 1291234. The free "starter" variant is mapped
    // deliberately: without it a downgrade writes no plan and the customer
    // keeps the paid tier they just left.
    "LEMONSQUEEZY_VARIANT_FREE": "2020313",
    "LEMONSQUEEZY_VARIANT_PRO": "2020319",
    "LEMONSQUEEZY_VARIANT_TEAM": "2020323",

    // Canonical public origin of the app host. Canonical links, OpenGraph URLs,
    // sitemap.xml and llms.txt are absolute against it, and any host that isn't
    // this one serves a disallow-everything robots.txt — so a preview deploy
    // (*.workers.dev) can never compete with production in a search index.
    "PUBLIC_BASE_URL": "https://rtfx.pro"
  }

  // Secrets (NOT in this file): SESSION_SECRET signs session cookies, and
  // LEMONSQUEEZY_WEBHOOK_SECRET verifies billing webhooks. Both via
  // `wrangler secret put`. CF_API_TOKEN is gone with Cloudflare Access.
}
