{
  // Cloudflare Workers config. Run `npm run setup` to fill in the placeholders
  // automatically, or edit them by hand (see README → Deployment).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "observability": { "enabled": true },

  // Three hosts, two roles. `rtfx.pro` and `mcp.rtfx.pro` are both **app** hosts:
  // one Worker, one code path, everything under MANAGEMENT_PREFIXES (src/host.ts)
  // — /admin, /api, /mcp, /oauth, /.well-known — answers on either. `a.rtfx.pro`
  // is the **content** host and serves uploaded artifact files only.
  //
  // `mcp.rtfx.pro` exists so `claude mcp add --transport http rtfx
  // https://mcp.rtfx.pro/mcp` has a hostname that says what it is. It is NOT in
  // CONTENT_HOSTNAMES and must never be: it terminates bearer credentials and
  // serves the OAuth authorization server, which is the exact thing the origin
  // split keeps away from untrusted uploaded HTML.
  //
  // The OAuth metadata is built from the origin each request arrived on
  // (src/oauth-routes.ts), so a client that discovers rtfx at mcp.rtfx.pro is
  // issued `issuer: https://mcp.rtfx.pro` and `resource:
  // https://mcp.rtfx.pro/mcp`, and RFC 8707 audience validation agrees with
  // itself. That is why the dedicated host is a route rather than a CNAME onto
  // the app host — see docs/REMOTE_MCP_OAUTH.md §3.
  //
  // Each pattern must be a zone on your account; `wrangler deploy` creates the
  // custom domain and its DNS record.
  "routes": [
    { "pattern": "rtfx.pro", "custom_domain": true },
    { "pattern": "mcp.rtfx.pro", "custom_domain": true },
    { "pattern": "a.rtfx.pro", "custom_domain": true }
  ],

  "r2_buckets": [{ "binding": "FILES", "bucket_name": "artifacts-files" }],

  // One chat room per artifact. Keyed by slug, so the coordination atom is a
  // single document's conversation rather than a global bottleneck.
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],

  // `npm run setup` (or `wrangler d1 create`) fills in database_id.
  "d1_databases": [
    { "binding": "DB", "database_name": "artifacts-meta", "database_id": "05f77557-3709-43b9-aad8-0cddf53765a8" }
  ],

  // Cloudflare Email Sending. Restricted to one sender on purpose: this Worker
  // also serves user-uploaded HTML from a.rtfx.pro, so capping the addresses it
  // can send From limits the blast radius of any future bug. Requires
  // `wrangler email sending enable rtfx.pro` to have been run on the account.
  // Never add "remote": true here — that sends real mail from local dev.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@rtfx.pro"] }
  ],

  "vars": {
    // Comma-separated emails with admin (publish/delete/manage) rights.
    "ADMIN_EMAILS": "yogevgab@gmail.com",
    // Envelope sender for transactional email. Must appear in the EMAIL
    // binding's allowed_sender_addresses above.
    "MAIL_FROM": "no-reply@rtfx.pro",
    // Cloudflare Access is intentionally disabled for rtfx.pro production.
    // Public sign-in is app-owned email OTP/session; leaving stale Access AUDs
    // here would create a parallel identity path that bypasses signup/account
    // attachment. Use app API tokens for non-interactive publishing instead.
    "ADMIN_SERVICE_TOKENS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Comma-separated hostnames that serve artifact content ONLY (no admin/API/
    // dashboard). Each hostname listed here must also have a `routes` entry above.
    // Leave empty to keep a single origin.
    //
    // `mcp.rtfx.pro` is deliberately absent: it is an app host. Adding it here
    // would 404 the very endpoints it exists to serve, and would strike it from
    // `appOrigins` (src/cors.ts) so its own consent form could not POST to itself.
    "CONTENT_HOSTNAMES": "a.rtfx.pro",
    // Custom domains (docs/CUSTOM_DOMAINS.md, phase 1) are OFF unless this is the
    // string "true". Leave it unset in production until migration 0025 is applied
    // and Cloudflare for SaaS is enabled on the zone; then add
    //   "CUSTOM_DOMAINS_ENABLED": "true",
    // (public copy still says custom domains are not available — phase 3).
    // --- Lemon Squeezy billing. The signing secret is NOT here: it is set with
    //     `wrangler secret put LEMONSQUEEZY_WEBHOOK_SECRET`. ---
    // The store's SUBDOMAIN, not the numeric store id (#452239) — hosted
    // checkout URLs address a store as <subdomain>.lemonsqueezy.com.
    "LEMONSQUEEZY_STORE_ID": "rtfxpro",
    // LIVE-mode variants of product 1291243 (test-mode ids 2020313/19/23 do
    // not exist on the live store). The free "starter" variant is mapped
    // deliberately: without it a downgrade writes no plan and the customer
    // keeps the paid tier they just left. Pro $12/mo and Team $40/mo are flat
    // monthly subscriptions — must match PLAN_PRICE in src/plan-copy.ts.
    "LEMONSQUEEZY_VARIANT_FREE": "2020328",
    "LEMONSQUEEZY_VARIANT_PRO": "2020329",
    "LEMONSQUEEZY_VARIANT_TEAM": "2020330",
    // Checkout slugs of those variants (Share dialog → star the variant → the
    // UUID after /checkout/buy/). Checkout links use these, not numeric ids.
    "LEMONSQUEEZY_CHECKOUT_PRO": "6ef9bec1-b7f2-40f5-b3b2-0c3bc5d824a7",
    "LEMONSQUEEZY_CHECKOUT_TEAM": "a35b7782-5fc7-46db-81e7-c2b33f44561a",

    // Who operates rtfx.pro, for /privacy and /terms (src/legal.ts). Owner's
    // decision 2026-11-02: an individual in Israel, Israeli law; contact mailbox
    // is Cloudflare Email Routing → owner's inbox. No postal address published.
    "LEGAL_OPERATOR": "Yogev Gabrielovitch",
    "LEGAL_OPERATOR_DETAIL": "an individual sole proprietor based in Israel",
    "LEGAL_CONTACT": "privacy@rtfx.pro",
    "LEGAL_GOVERNING_LAW": "the State of Israel",
    "LEGAL_COURTS": "the competent courts of the Tel Aviv district, Israel",

    // Canonical public origin of the app host. Canonical links, OpenGraph URLs,
    // sitemap.xml and llms.txt are absolute against it, and any host that isn't
    // this one serves a disallow-everything robots.txt — so a preview deploy
    // (*.workers.dev) can never compete with production in a search index.
    //
    // It stays `rtfx.pro` with mcp.rtfx.pro routed: the MCP host is a machine
    // surface, and being non-canonical is what keeps its copy of the marketing
    // pages out of the index. It does not restrict OAuth, whose documents name
    // the origin each request arrived on rather than this value.
    "PUBLIC_BASE_URL": "https://rtfx.pro"
  }

  // Secrets (NOT in this file): SESSION_SECRET signs session cookies, and
  // LEMONSQUEEZY_WEBHOOK_SECRET verifies billing webhooks. Both via
  // `wrangler secret put`. CF_API_TOKEN is gone with Cloudflare Access.
}
