{
  // Cloudflare Workers config. Run `npm run setup` to fill in the placeholders
  // automatically, or edit them by hand (see README → Deployment).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },

  // rtfx.pro = app/dashboard/API; a.rtfx.pro = artifact content only (must be a
  // zone on your account). See CONTENT_HOSTNAMES below for the isolation this pairs with.
  "routes": [
    { "pattern": "rtfx.pro", "custom_domain": true },
    { "pattern": "a.rtfx.pro", "custom_domain": true }
  ],

  "r2_buckets": [{ "binding": "FILES", "bucket_name": "artifacts-files" }],

  // `npm run setup` (or `wrangler d1 create`) fills in database_id.
  "d1_databases": [
    { "binding": "DB", "database_name": "artifacts-meta", "database_id": "05f77557-3709-43b9-aad8-0cddf53765a8" }
  ],

  "vars": {
    // Comma-separated emails with admin (publish/delete/manage) rights.
    "ADMIN_EMAILS": "yogevgab@gmail.com",
    // Comma-separated Access service-token client ids (…access) that get admin
    // rights — used by the CLI. `npm run setup` fills this in.
    "ADMIN_SERVICE_TOKENS": "",
    // Your Cloudflare Zero Trust team domain, e.g. myteam.cloudflareaccess.com.
    "ACCESS_TEAM_DOMAIN": "",
    // Comma-separated Access application AUD tags: "<viewerAud>,<adminAud>".
    // The Worker verifies request JWTs against either. `npm run setup` fills this in.
    "ACCESS_AUD": "",
    // Account + viewer-app identifiers used to manage the login allow-list via
    // the Cloudflare API. `npm run setup` fills these in.
    "CF_ACCOUNT_ID": "fac060161220992adb92c048d8d8f8b5",
    "ACCESS_VIEWER_APP_ID": "",
    "ACCESS_VIEWER_POLICY_ID": "",
    // Comma-separated hostnames that serve artifact content ONLY (no admin/API/
    // dashboard). Each hostname listed here must also have a `routes` entry above.
    // Leave empty to keep a single origin.
    "CONTENT_HOSTNAMES": "a.rtfx.pro"
  }

  // Secret (NOT in this file): CF_API_TOKEN — a Cloudflare API token with
  // "Access: Apps and Policies — Edit". Set it with:
  //   wrangler secret put CF_API_TOKEN
  // Only needed for in-app user management; the app runs fine without it.
}
