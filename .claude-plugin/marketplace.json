{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "rtfx",
  "description": "Claude Code integrations for rtfx.pro - publish what a session just built, behind real access control",
  "version": "2.0.0",
  "owner": {
    "name": "rtfx.pro",
    "url": "https://rtfx.pro"
  },
  "plugins": [
    {
      "name": "rtfx",
      "source": "./plugins/rtfx",
      "description": "Publish HTML pages and small sites to rtfx.pro from a Claude Code session through the hosted rtfx MCP server - versioned, access-controlled, with a stable URL",
      "version": "2.0.0",
      "author": {
        "name": "rtfx.pro",
        "url": "https://rtfx.pro"
      },
      "homepage": "https://rtfx.pro/docs",
      "repository": "https://github.com/yogevgab/artifacts-server",
      "license": "MIT",
      "keywords": [
        "publishing",
        "artifacts",
        "hosting",
        "mcp",
        "rtfx"
      ],
      "category": "deployment",
      "strict": true
    },
    {
      "name": "rtfx-local",
      "source": "./plugins/rtfx-local",
      "description": "Full local rtfx.pro tooling: publish a folder, build output or zip from disk by path, with slash commands and a local MCP server",
      "version": "1.3.0",
      "author": {
        "name": "rtfx.pro",
        "url": "https://rtfx.pro"
      },
      "homepage": "https://rtfx.pro/docs",
      "repository": "https://github.com/yogevgab/artifacts-server",
      "license": "MIT",
      "keywords": [
        "publishing",
        "artifacts",
        "hosting",
        "cloudflare",
        "mcp",
        "rtfx"
      ],
      "category": "deployment",
      "strict": true
    }
  ]
}
