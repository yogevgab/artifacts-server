{
  "name": "artifacts-server",
  "version": "1.0.0",
  "description": "Private, access-gated hosting for landing pages and HTML/Claude artifacts on Cloudflare Workers — with per-artifact permissions and versioning.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "cloudflare",
    "workers",
    "hono",
    "r2",
    "d1",
    "cloudflare-access",
    "static-hosting",
    "artifacts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yogevgab/artifacts-server.git"
  },
  "bin": {
    "artifacts": "cli/artifacts.mjs",
    "rtfx-mcp": "plugins/rtfx/scripts/rtfx-mcp.mjs"
  },
  "scripts": {
    "dev": "wrangler dev --var DEV_LOGIN:true",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "validate:deploy": "node scripts/validate-deploy-config.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run && node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.19",
    "@cloudflare/workers-types": "^5.0.0",
    "@vitest/runner": "3.1.4",
    "@vitest/snapshot": "3.1.4",
    "typescript": "^5.7.3",
    "vitest": "3.1.4",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
